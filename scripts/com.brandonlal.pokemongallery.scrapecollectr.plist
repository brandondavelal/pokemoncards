<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brandonlal.pokemongallery.scrapecollectr</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/brandon/Desktop/pokemon-gallery-cms/scripts/run-scrape.sh</string>
  </array>

  <!-- AUTO_PUSH=1: each run commits + pushes data.js/images to the pokemoncards
       repo (via the dedicated SSH key/config set up for this) if they changed. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>AUTO_PUSH</key>
    <string>1</string>
  </dict>

  <!-- fires on load (i.e. on login) and every 6 hours after that while
       you're logged in (LaunchAgents don't run when logged out / machine off,
       so this is "as fresh as your Mac being awake and logged in", not truly
       every 6 hours on the dot if the machine sleeps through one).
       run-scrape.sh itself skips the actual scrape if a prior run succeeded
       less than 6h ago, so a login right after a scheduled run is a no-op. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>

  <key>StandardOutPath</key>
  <string>/Users/brandon/Desktop/pokemon-gallery-cms/scripts/logs/scrape.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brandon/Desktop/pokemon-gallery-cms/scripts/logs/scrape.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/brandon/Desktop/pokemon-gallery-cms/scripts</string>
</dict>
</plist>
