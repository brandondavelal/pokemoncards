<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brandonlal.pokemongallery.scrapecollectr</string>

  <!-- invoked via /bin/bash explicitly (rather than relying on run-scrape.sh's
       own shebang) because launchd's TCC access to ~/Desktop is granted per the
       interpreter binary, not the script it's running. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/brandon/Desktop/pokemon-gallery-cms/scripts/run-scrape.sh</string>
  </array>

  <!-- AUTO_PUSH=1: each run commits + pushes data.js/images to the pokemoncards
       repo (via the dedicated SSH key/config set up for this) if they changed. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>AUTO_PUSH</key>
    <string>1</string>
  </dict>

  <!-- fires on load (i.e. on login) and every 6 hours after that while
       you're logged in (LaunchAgents don't run when logged out / machine off,
       so this is "as fresh as your Mac being awake and logged in", not truly
       every 6 hours on the dot if the machine sleeps through one).
       run-scrape.sh itself skips the actual scrape if a prior run succeeded
       less than 6h ago, so a login right after a scheduled run is a no-op. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>

  <!-- Deliberately NOT under ~/Desktop: launchd itself opens these paths before
       spawning the job, and (unlike the job's own process) launchd doesn't have
       TCC access to the Desktop folder, so a log path there makes the whole job
       fail to spawn (EX_CONFIG) even though the script itself is fine. -->
  <key>StandardOutPath</key>
  <string>/Users/brandon/Library/Logs/pokemongallery/scrape.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brandon/Library/Logs/pokemongallery/scrape.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/brandon/Desktop/pokemon-gallery-cms/scripts</string>
</dict>
</plist>
